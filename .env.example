# Telegram bot token from @BotFather (required)
TELEGRAM_BOT_TOKEN=

# Path to the Claude Code CLI binary (default: "claude" on PATH)
CLAUDE_BIN=claude

# Model alias or full name for the CLI (default: sonnet)
CLAUDE_MODEL=sonnet

# Seconds to wait for a Claude CLI response before timing out (web search is slow)
CLAUDE_TIMEOUT=240

# Where the SQLite database lives
DB_PATH=data/fleet.db

# Where uploaded FSM (Factory Service Manual) PDFs are stored
FSM_DIR=fsm_files

# Optional: comma-separated Telegram user IDs allowed to use the bot.
# Leave empty to allow everyone. Example: ALLOWED_USER_IDS=12345678,98765432
ALLOWED_USER_IDS=
